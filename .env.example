# Copier vers .env puis adapter. Ne jamais committer .env.
PORT=3001
WEB_PORT=5173
DB_PATH=data/ne-learn.sqlite
CONTENT_DIR=content
# Derrière un reverse proxy de confiance uniquement :
TRUST_PROXY=false
# true si le site est servi exclusivement en HTTPS :
COOKIE_SECURE=false
# CSP frame-ancestors en production. Liste séparée par des virgules.
# Exemple pour autoriser l'aperçu Arena : FRAME_ANCESTORS='self',https://*.e2b.app
FRAME_ANCESTORS='self'
# Sauvegardes :
BACKUP_DIR=data/backups
